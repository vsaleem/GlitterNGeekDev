# Feature flags
# Set to "true" to enable the Courses page in navigation and homepage CTAs
NEXT_PUBLIC_COURSES_PAGE_RELEASE_PROD=false
# Portfolio stays available in local development. Set this to "true" only when
# the Portfolio page should be exposed in production navigation and by URL.
NEXT_PUBLIC_PORTFOLIO_PAGE_RELEASE_PROD=false

# Customer learning application (server-only)
# Keep disabled in production until identity, entitlements, release PDFs, and
# customer policies pass launch review.
GNG_LEARNING_APP_ENABLED=false
# Local preview only. Never enable this in production.
GNG_LEARNING_DEV_ACCESS=false
GNG_LEARNING_DEV_EMAIL=victoria@example.com
GNG_LEARNING_DEV_NAME=Victoria
# Comma-separated local preview access. Toolkit stays unpurchased by default.
GNG_LEARNING_DEV_ENTITLEMENTS=quick-start
# Supabase's URL and publishable key are safe for browser-visible auth clients;
# database RLS remains the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase projects may use the anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by signed Stripe webhooks to grant paid access.
SUPABASE_SERVICE_ROLE_KEY=
# Absolute paths to release-ready exports. Review-draft PDFs must not be used.
# These are local-development fallbacks; production should use private storage.
GNG_QUICK_START_PDF_PATH=
GNG_TOOLKIT_PDF_PATH=
GNG_LEARNING_STORAGE_BUCKET=learning-pdfs
GNG_QUICK_START_PDF_OBJECT=release/GlitterNGeek-Three-Day-AI-Quick-Start.pdf
GNG_TOOLKIT_PDF_OBJECT=release/GlitterNGeek-Small-Business-AI-Toolkit.pdf

# Stripe Checkout (server-only; never prefix secrets with NEXT_PUBLIC_)
# Keep checkout disabled until the price, delivery, policies, webhook, and
# Bluevine payout destination have all passed the activation checklist.
GNG_CHECKOUT_ENABLED=false
GNG_SITE_URL=http://localhost:3000
GNG_FULFILLMENT_MODE=entitlements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SMALL_BUSINESS_AI_TOOLKIT=
STRIPE_AUTOMATIC_TAX=false
