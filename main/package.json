{
  "name": "main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:staging": "APP_ENV=staging next dev",
    "dev:prod": "APP_ENV=production next dev",
    "build": "next build",
    "build:dev": "APP_ENV=development next build",
    "build:staging": "APP_ENV=staging next build",
    "build:production": "APP_ENV=production next build",
    "start": "next start",
    "start:prod": "APP_ENV=production next start",
    "preview:prod": "npm run build:production && npm run start:prod",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "security-check": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "flags": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.540.0",
    "next": "^15.5.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "15.4.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
